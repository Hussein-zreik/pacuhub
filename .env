# ─────────────────────────────────────────────────────────────────────────────
# PACU Hub — shared, committed configuration.
#
# PACU Hub has its OWN Firebase project, fully separate from SNV2's
# (schedule-nursing-f14e5), so nothing here can ever affect the ward roster.
#
# The Firebase web config is PUBLIC by design: it identifies the project and
# is visible in every user's browser. Access is enforced by Firebase Auth +
# Firestore Security Rules. Never put secrets in this file.
# Personal/local overrides go in `.env.local` (git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# ⏳ Fill in from the NEW PACU Hub Firebase project (see docs/ACCESS_SETUP.md).
# Until then the app shows a "Configuration required" screen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_IDLE_TIMEOUT_MINUTES=5
VITE_IDLE_WARNING_SECONDS=60

# Sign-in: email + password accounts that the Nurse Manager creates for each
# person. (Google sign-in is supported but off; set "password,google" to offer it.)
VITE_SIGN_IN_METHODS=password

# Optional: VITE_ALLOWED_EMAIL_DOMAINS=aub.edu.lb

# SNV2 (separate app, GitHub Pages). Wiring pending the Schedule tab decision.
VITE_SNV2_MODE=launch
# VITE_SNV2_URL=https://hussein-zreik.github.io/SNV2/
