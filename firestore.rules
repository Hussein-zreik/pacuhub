rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// PACU Hub — Firestore Security Rules
//
// These rules are the REAL access control. The app's UI hides things a user
// can't do, but only these rules actually prevent it.
//
// All PACU Hub data lives in collections prefixed `pacuhub_` so it can never
// collide with SNV2's data in the same Firebase project.
//
// Access model (pacuhub_users/{uid}):
//   1. On first sign-in, a user may create their OWN record, and only as a
//      pending request with no roles.
//   2. A user may refresh their own name/photo/last-sign-in — never their
//      roles or status.
//   3. Only an active admin may change another user's roles/status.
//      Admins cannot change their own record (prevents self-lockout).
//   4. Nothing is ever deleted — deactivated users keep their record for the
//      audit trail.
//
// Anything not explicitly allowed below is denied by default.
//
// ⚠️ This Firebase project is shared with SNV2. Do NOT replace its existing
// rules: paste the helper functions and the `match /pacuhub_users/{uid}`
// block INSIDE the existing `match /databases/{database}/documents { … }`.
// If a helper name (e.g. signedIn) already exists there, keep one copy.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // The account must carry an email (Firebase sets it from the sign-in).
    // Email verification is NOT required: staff accounts are created by the
    // unit (shared with SNV2) and are typically unverified. Access is still
    // gated by admin approval in Staff Access.
    //
    // Optional: restrict to institutional addresses, e.g.:
    //   return request.auth.token.email is string
    //       && request.auth.token.email.matches('.*@(aub[.]edu[.]lb|aubmc[.]org[.]lb)$');
    function hasAccountEmail() {
      return request.auth.token.email is string && request.auth.token.email.size() > 3;
    }

    function profile() {
      return get(/databases/$(database)/documents/pacuhub_users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/pacuhub_users/$(request.auth.uid))
        && profile().status == 'active';
    }

    function hasRole(role) {
      return isActive() && role in profile().roles;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function validRoles(roles) {
      return roles is list
        && roles.size() <= 4
        && roles.hasOnly(['staff_nurse', 'charge_nurse', 'educator', 'admin']);
    }

    function optionalString(value) {
      return value == null || (value is string && value.size() <= 300);
    }

    // ── Staff access records ─────────────────────────────────────────────────

    match /pacuhub_users/{uid} {
      // Users read their own record; admins read everyone (staff list).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // First sign-in: create own record as a pending request with no roles.
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasAccountEmail()
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'roles', 'status', 'createdAt', 'lastSignInAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && optionalString(request.resource.data.displayName)
        && optionalString(request.resource.data.photoURL)
        && request.resource.data.roles == []
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSignInAt == request.time;

      // Self-service: refresh own profile details only.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'lastSignInAt'])
        && optionalString(request.resource.data.displayName)
        && optionalString(request.resource.data.photoURL)
        && request.resource.data.lastSignInAt == request.time;

      // Admin: grant / change / revoke another user's access.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['roles', 'status', 'updatedAt', 'updatedBy'])
        && validRoles(request.resource.data.roles)
        && request.resource.data.status in ['pending', 'active', 'disabled']
        // An active account must have at least one role.
        && (request.resource.data.status != 'active' || request.resource.data.roles.size() > 0)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
