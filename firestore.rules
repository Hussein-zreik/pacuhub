rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// PACU Hub — Firestore Security Rules
//
// These rules are the REAL access control. The app's UI hides things a user
// can't do, but only these rules actually prevent it.
//
// These rules are for PACU Hub's OWN Firebase project (separate from SNV2).
// Publish them by replacing the project's rules entirely.
// All PACU Hub collections are prefixed `pacuhub_` to keep names unambiguous.
//
// Access model (pacuhub_users/{uid}):
//   Each person has an `access` map: tab/area → level, e.g.
//     { "schedule": "view", "audits:infection-control": "enter",
//       "staff-access": "admin" }
//   A missing key means no access. Unknown values grant nothing.
//
//   1. On first sign-in, a user may create their OWN record, and only as a
//      pending request with NO access.
//   2. A user may refresh their own name/photo/last-sign-in — never their
//      access or status.
//   3. Only an active admin ("staff-access": "admin") may change access.
//      Admins may adjust their own tab access, but can never remove their
//      own admin level or deactivate themselves (prevents lockout).
//   4. Nothing is ever deleted — deactivated users keep their record for the
//      audit trail.
//
// Anything not explicitly allowed below is denied by default.
//
// Tested: rules-tests/users.rules.test.ts (npm run test:rules).
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // The account must carry an email (Firebase sets it from the sign-in).
    // Email verification is NOT required: staff accounts are created by the
    // Nurse Manager in the console and are typically unverified. Access is
    // still gated by admin approval in Staff Access.
    //
    // Optional: restrict to institutional addresses, e.g.:
    //   return request.auth.token.email is string
    //       && request.auth.token.email.matches('.*@(aub[.]edu[.]lb|aubmc[.]org[.]lb)$');
    function hasAccountEmail() {
      return request.auth.token.email is string && request.auth.token.email.size() > 3;
    }

    // Sign-up domain policy from unit settings (pacuhub_settings/public).
    // No settings document or an empty list = any domain may request access.
    function signupDomainAllowed() {
      let path = /databases/$(database)/documents/pacuhub_settings/public;
      let domains = exists(path) ? get(path).data.get('signup', {}).get('allowedDomains', []) : [];
      return domains.size() == 0
        || request.auth.token.email.lower().split('@')[1] in domains;
    }

    function unitIdleMax() {
      let path = /databases/$(database)/documents/pacuhub_settings/public;
      return exists(path) ? get(path).data.get('idle', {}).get('maxMinutes', 5) : 5;
    }

    function profile() {
      return get(/databases/$(database)/documents/pacuhub_users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/pacuhub_users/$(request.auth.uid))
        && profile().status == 'active';
    }

    // The person's level in one tab/area, or 'none'.
    function accessOf(key) {
      return profile().get('access', {}).get(key, 'none');
    }

    // Use in future collections' rules, e.g. for audit data:
    //   allow create: if hasLevel('audits:infection-control', ['enter', 'full']);
    //   allow read:   if hasLevel('audits:infection-control', ['view', 'enter', 'full']);
    function hasLevel(key, allowedLevels) {
      return isActive() && accessOf(key) in allowedLevels;
    }

    function isAdmin() {
      return hasLevel('staff-access', ['admin']);
    }

    // Values are validated by the app; unknown levels grant nothing because
    // every data rule checks for explicit level names (see hasLevel).
    function validAccess(access) {
      return access is map && access.size() <= 64;
    }

    // Link from a staff account to their id on the SNV2 roster (admins set it).
    function validRosterId(d) {
      return d.get('rosterId', null) == null
        || (d.rosterId is string && d.rosterId.size() >= 1 && d.rosterId.size() <= 40);
    }

    function optionalString(value) {
      return value == null || (value is string && value.size() <= 300);
    }

    // ── Staff access records ─────────────────────────────────────────────────

    match /pacuhub_users/{uid} {
      // Users read their own record; admins read everyone (staff list).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // First sign-in: create own record as a pending request with no access.
      // Note: `owner` is NOT an allowed key here or in any update rule below,
      // so an owner account can only be marked by hand in the Firebase console,
      // never created or changed through the app.
      allow create: if signedIn()
        && request.auth.uid == uid
        && hasAccountEmail()
        && signupDomainAllowed()
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'access', 'status', 'createdAt', 'lastSignInAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && optionalString(request.resource.data.displayName)
        && optionalString(request.resource.data.photoURL)
        && request.resource.data.access == {}
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSignInAt == request.time;

      // Self-service: refresh own profile details only.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'lastSignInAt'])
        && optionalString(request.resource.data.displayName)
        && optionalString(request.resource.data.photoURL)
        && request.resource.data.lastSignInAt == request.time;

      // Admin: grant / change / revoke ANOTHER user's access.
      // An owner ("master") account can never be changed by anyone else.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && resource.data.get('owner', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['access', 'status', 'rosterId', 'updatedAt', 'updatedBy'])
        && validAccess(request.resource.data.access)
        && validRosterId(request.resource.data)
        && request.resource.data.status in ['pending', 'active', 'disabled']
        // An active account must have access to at least one tab.
        && (request.resource.data.status != 'active' || request.resource.data.access.size() > 0)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      // Admin: adjust their OWN tab access — but the admin level must stay,
      // and status can't change (no self-deactivation / lockout).
      allow update: if isAdmin()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['access', 'rosterId', 'updatedAt', 'updatedBy'])
        && validAccess(request.resource.data.access)
        && validRosterId(request.resource.data)
        && request.resource.data.access.get('staff-access', 'none') == 'admin'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── Day-off request decisions (History / Undo) ──────────────────────────
    // One record per decided SNV2 request: approved / rejected, and exactly
    // which days an approval wrote into the SNV2 roster (so Undo can remove
    // only those). Schedule managers only.
    function validDecision(id, d) {
      return d.keys().hasOnly(['formId', 'requestId', 'rnId', 'name', 'dates', 'reason',
                               'decision', 'applied', 'notesWritten', 'skipped', 'decidedBy', 'decidedAt'])
        && d.formId is string && d.formId.matches('^[A-Za-z0-9]{20,40}$')
        && d.requestId is string && d.requestId.matches('^[A-Za-z0-9]{1,64}$')
        && id == d.formId + '__' + d.requestId
        && d.rnId is string && d.rnId.size() <= 40
        && d.name is string && d.name.size() <= 120
        && d.reason is string && d.reason.size() <= 300
        && d.decision in ['approved', 'rejected']
        && d.dates is list && d.dates.size() <= 14
        && d.applied is list && d.applied.size() <= 14
        && d.notesWritten is list && d.notesWritten.size() <= 14
        && d.skipped is list && d.skipped.size() <= 14
        && (d.decision == 'approved' || d.applied.size() == 0)
        && d.decidedBy == request.auth.uid
        && d.decidedAt == request.time;
    }

    match /pacuhub_dayoff_decisions/{id} {
      allow read: if hasLevel('schedule', ['manage']);
      allow create, update: if hasLevel('schedule', ['manage']) && validDecision(id, request.resource.data);
      allow delete: if hasLevel('schedule', ['manage']);
    }

    // ── Published roster ─────────────────────────────────────────────────────
    // A copy of each fortnight LOCKED in SNV2, for staff to view. Written only
    // by the automatic sync (schedule managers). Contains names and shift codes
    // only — never SNV2 day comments.
    match /pacuhub_rosters/{start} {
      allow read: if hasLevel('schedule', ['view', 'manage']) || isAdmin();
      allow create, update: if hasLevel('schedule', ['manage'])
        && start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['start', 'lockedAt', 'rns', 'groups', 'shifts', 'fp', 'syncedAt', 'syncedBy'])
        && request.resource.data.start == start
        && request.resource.data.lockedAt is string && request.resource.data.lockedAt.size() <= 40
        && request.resource.data.rns is list && request.resource.data.rns.size() <= 120
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 10
        && request.resource.data.shifts is list && request.resource.data.shifts.size() <= 20
        && request.resource.data.fp is string && request.resource.data.fp.size() <= 16
        && request.resource.data.syncedBy == request.auth.uid
        && request.resource.data.syncedAt == request.time;
      allow delete: if hasLevel('schedule', ['manage']);
    }

    // ── Unit settings ────────────────────────────────────────────────────────
    function settingsStamp(d) {
      return d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.updatedByName is string && d.updatedByName.size() <= 120;
    }

    // Public: the login screen needs it before anyone signs in. Admin-only writes.
    match /pacuhub_settings/public {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['signup', 'idle', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.signup.keys().hasOnly(['enabled', 'allowedDomains'])
        && request.resource.data.signup.enabled is bool
        && request.resource.data.signup.allowedDomains is list
        && request.resource.data.signup.allowedDomains.size() <= 10
        && request.resource.data.idle.keys().hasOnly(['maxMinutes', 'warningSeconds'])
        // Auto sign-out can never be switched off or made very long.
        && request.resource.data.idle.maxMinutes is int
        && request.resource.data.idle.maxMinutes >= 2 && request.resource.data.idle.maxMinutes <= 30
        && request.resource.data.idle.warningSeconds is int
        && request.resource.data.idle.warningSeconds >= 15 && request.resource.data.idle.warningSeconds <= 120
        && settingsStamp(request.resource.data);
      allow delete: if false;
    }

    // App: shifts, announcement, default template. Active staff read; admins write.
    match /pacuhub_settings/app {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['shifts', 'announcement', 'defaultTemplate', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.shifts.dayStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.shifts.dayEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.shifts.dayStart != request.resource.data.shifts.dayEnd
        && (request.resource.data.announcement == null
            || (request.resource.data.announcement.text is string
                && request.resource.data.announcement.text.size() >= 1
                && request.resource.data.announcement.text.size() <= 280
                && request.resource.data.announcement.tone in ['info', 'warning']))
        && request.resource.data.defaultTemplate in ['staff-nurse', 'charge-nurse', 'educator', 'nurse-manager']
        && settingsStamp(request.resource.data);
      allow delete: if false;
    }

    // ── Live bay board ───────────────────────────────────────────────────────
    // NO patient data: status, assigned nurse, fixed tags, fixed delay reason
    // and times only. There is no free-text field. Levels: view · update · manage.
    function bayViewer() {
      return hasLevel('bayboard', ['view', 'update', 'manage']);
    }

    // A time field may stay as it was, be cleared, or be set to server time.
    function bayStampOk(f) {
      let v = request.resource.data.get(f, null);
      return v == null || v == request.time || (resource != null && v == resource.data.get(f, null));
    }

    function validBay(d) {
      return d.keys().hasOnly(['name', 'order', 'status', 'nurse', 'tags', 'delayReason', 'inRecoveryAt', 'careCompleteAt',
                               'updatedAt', 'updatedBy', 'updatedByName'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 24
        && d.order is int && d.order >= 0 && d.order <= 999
        && d.status in ['empty', 'in-recovery', 'care-complete', 'closed']
        && (d.nurse == null
            || (d.nurse is map && d.nurse.keys().hasOnly(['uid', 'name'])
                && d.nurse.name is string && d.nurse.name.size() >= 1 && d.nurse.name.size() <= 80
                && (d.nurse.get('uid', null) == null || d.nurse.uid is string)))
        && d.tags is list && d.tags.size() <= 4 && d.tags.hasOnly(['isolation', 'pediatric', 'oxygen', 'fall-risk'])
        && (d.delayReason == null || d.delayReason in ['awaiting-bed', 'awaiting-transport', 'awaiting-physician', 'other'])
        // Only an occupied bay carries a nurse, tags or a delay; a delay only after care complete.
        && (d.status in ['in-recovery', 'care-complete'] || (d.nurse == null && d.tags.size() == 0 && d.delayReason == null))
        && (d.status == 'care-complete' || d.delayReason == null)
        && bayStampOk('inRecoveryAt') && bayStampOk('careCompleteAt')
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.updatedByName is string && d.updatedByName.size() <= 120;
    }

    match /pacuhub_bays/{bayId} {
      allow read: if bayViewer();
      allow create: if hasLevel('bayboard', ['manage'])
        && validBay(request.resource.data)
        && request.resource.data.status == 'empty';
      // Update level: patient flow only — not names, order, or closing/opening bays.
      allow update: if validBay(request.resource.data)
        && (hasLevel('bayboard', ['manage'])
            || (hasLevel('bayboard', ['update'])
                && request.resource.data.name == resource.data.name
                && request.resource.data.order == resource.data.order
                && resource.data.status != 'closed'
                && request.resource.data.status != 'closed'));
      allow delete: if hasLevel('bayboard', ['manage']) && resource.data.status in ['empty', 'closed'];
    }

    match /pacuhub_bayboard/config {
      allow read: if bayViewer();
      allow create, update: if hasLevel('bayboard', ['manage'])
        && request.resource.data.keys().hasOnly(['thresholds', 'capacity', 'updatedAt', 'updatedBy', 'updatedByName'])
        && request.resource.data.thresholds.keys().hasOnly(['recovery', 'complete'])
        && validThreshold(request.resource.data.thresholds.recovery)
        && validThreshold(request.resource.data.thresholds.complete)
        && request.resource.data.capacity.keys().hasOnly(['level', 'note'])
        && request.resource.data.capacity.level in ['green', 'amber', 'red']
        && request.resource.data.capacity.note is string && request.resource.data.capacity.note.size() <= 120
        && settingsStamp(request.resource.data);
      allow delete: if false;
    }

    function validThreshold(t) {
      return t.keys().hasOnly(['amber', 'red'])
        && t.amber is int && t.red is int
        && t.amber >= 5 && t.red <= 600 && t.amber < t.red;
    }

    function optionalMinutes(v) {
      return v == null || (v is int && v >= 0 && v <= 2880);
    }

    // Flow events for today's statistics: append-only, no patient data.
    match /pacuhub_bay_events/{eventId} {
      allow read: if bayViewer();
      allow create: if hasLevel('bayboard', ['update', 'manage'])
        && request.resource.data.keys().hasOnly(['bayId', 'bayName', 'action', 'delayReason', 'recoveryMin', 'waitMin', 'by', 'at'])
        && request.resource.data.bayId is string && request.resource.data.bayId.size() <= 40
        && request.resource.data.bayName is string && request.resource.data.bayName.size() <= 24
        && request.resource.data.action in ['in', 'complete', 'out']
        && (request.resource.data.delayReason == null
            || request.resource.data.delayReason in ['awaiting-bed', 'awaiting-transport', 'awaiting-physician', 'other'])
        && optionalMinutes(request.resource.data.recoveryMin)
        && optionalMinutes(request.resource.data.waitMin)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── Personal preferences (each person's own) ────────────────────────────
    match /pacuhub_prefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['theme', 'textSize', 'startPage', 'idleMinutes', 'updatedAt'])
        && request.resource.data.theme in ['light', 'dark', 'system']
        && request.resource.data.textSize in ['normal', 'large', 'xlarge']
        && (request.resource.data.startPage == null
            || (request.resource.data.startPage is string && request.resource.data.startPage.size() <= 40))
        // Personal sign-out time may only be SHORTER than the unit maximum.
        && (request.resource.data.idleMinutes == null
            || (request.resource.data.idleMinutes is int
                && request.resource.data.idleMinutes >= 2
                && request.resource.data.idleMinutes <= unitIdleMax()))
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── Activity log (append-only) ───────────────────────────────────────────
    match /pacuhub_activity/{entryId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['type', 'summary', 'by', 'byName', 'at'])
        && request.resource.data.type in ['access', 'settings', 'dayoff', 'schedule']
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── Schedule settings ────────────────────────────────────────────────────
    // The SNV2 staff request link. Kept here (not in the public code) because
    // its form id opens the request form and its staff name list.
    match /pacuhub_settings/schedule {
      allow read: if hasLevel('schedule', ['view', 'manage']);

      allow create, update: if hasLevel('schedule', ['manage'])
        && request.resource.data.keys().hasOnly(['requestLink', 'updatedAt', 'updatedBy'])
        && (request.resource.data.requestLink == null
            || (request.resource.data.requestLink is string
                && request.resource.data.requestLink.matches(
                     '^https://hussein-zreik[.]github[.]io/SNV2/request[.]html[?]f=[A-Za-z0-9]{20,40}$')))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
