# ─────────────────────────────────────────────────────────────────────────────
# PACU Hub environment configuration
# Copy to `.env.local` and fill in. Values prefixed VITE_ are bundled into the
# client — never put secrets here (Firebase web config is NOT a secret; access
# is enforced by Firebase Security Rules).
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional comma-separated list of allowed Google account domains (UX check
# only — the real enforcement belongs in Security Rules / blocking functions).
# Example: aub.edu.lb,aubmc.org.lb
VITE_ALLOWED_EMAIL_DOMAINS=

# Sign-in options on the login screen: password, google, or both (comma-separated).
# Default: password (shares accounts with SNV2).
VITE_SIGN_IN_METHODS=password

# Auto-logout on inactivity (shared clinical workstations)
VITE_IDLE_TIMEOUT_MINUTES=5
VITE_IDLE_WARNING_SECONDS=60

# SNV2 scheduling app
#   embed  → shown inside the Schedule tab (SNV2 must allow framing via CSP frame-ancestors)
#   launch → launchpad card that opens SNV2 in a new tab
VITE_SNV2_URL=
VITE_SNV2_MODE=launch
